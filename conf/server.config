/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the riboseq pipeline on a production server
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Oryza sativa Riboseq vs polyA RNA production configuration.
    由原 conf/SRP189094.config（本地测试版）与 rice/riboseq.config（服务器版）合并而来，
    输入/输出改为命令行指定以保持通用；基因组路径统一通过 --genome 从下方 genomes map 解析
    （genomes map 拷贝自 circdna.nf/conf/server.config，并补充各物种 GTF）。

    Usage:
        # 输入样本表、对比文件、输出目录均通过命令行指定
        nextflow run main.nf -profile server,docker \
            --genome Oryza_sativa \
            --input samplesheets/SRP189094.csv \
            --contrasts samplesheets/SRP189094_contrasts.csv \
            --outdir /data1/users/siyangming/rice/osa_Japonica/SRP189094_results

    路径可通过环境变量覆盖：RIBOSEQ_BASE_DIR / RIBOSEQ_PROJECT_DIR / RIBOSEQ_RNADB_DIR
    / RIBOSEQ_PIPELINE_DIR；参考基因组根目录通过 --fasta_base_path 或 fasta_base_path 覆盖。
----------------------------------------------------------------------------------------
*/

resume = true

params {
    config_profile_name        = 'Server profile - riboseq'
    config_profile_description = 'Production configuration for riboseq pipeline (128 CPUs / 503GB memory server)'

    // 资源上限（可用命令行 --max_cpus 等覆盖）
    max_memory = '400.GB'
    max_cpus   = 100
    max_time   = '48.h'

    // ============================================================================
    // Base directories (override via environment variables)
    // ============================================================================
    riboseq_base_dir     = System.getenv('RIBOSEQ_BASE_DIR')     ?: '/data1/users/siyangming'
    riboseq_pipeline_dir = System.getenv('RIBOSEQ_PIPELINE_DIR') ?: "${params.riboseq_base_dir}/nextflow_nf_core/riboseq.nf"
    riboseq_project_dir  = System.getenv('RIBOSEQ_PROJECT_DIR')  ?: "${params.riboseq_base_dir}/rice/osa_Japonica/SRP189094_results"
    riboseq_rnadb_dir    = System.getenv('RIBOSEQ_RNADB_DIR')    ?: "${params.riboseq_pipeline_dir}/RNAdb"

    // 参考基因组根目录 —— 服务器实际数据位于 PublicDB/reference（与 circdna.nf / isoseq.nf 一致）
    fasta_base_path = "/data1/users/siyangming/PublicDB/reference"

    // ============================================================================
    // Input/Output Configuration（必须通过命令行指定）
    // ============================================================================
    input = null
    contrasts = null
    outdir = null

    // ============================================================================
    // Genome registry：key 对应 --genome；fasta 路径基于 ${params.fasta_base_path} 拼接
    // （拷贝自 circdna.nf/conf/server.config）。GTF 仅为 STAR 等比对器所需，
    // 服务器上无 GTF 的物种仅支持部分流程（gtf = null 时需 --gtf 命令行覆盖）。
    // ============================================================================
    genomes {
        Arabidopsis_thaliana {
            fasta = "${params.fasta_base_path}/Arabidopsis_thaliana/Arabidopsis_thaliana.TAIR10.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Arabidopsis_thaliana/Arabidopsis_thaliana.TAIR10.63.gtf.gz"
        }
        Oryza_sativa {
            fasta = "${params.fasta_base_path}/Oryza_sativa/Oryza_sativa.IRGSP-1.0.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Oryza_sativa/Oryza_sativa.IRGSP-1.0.63.gtf.gz"
        }
        Triticum_aestivum {
            fasta = "${params.fasta_base_path}/Triticum_aestivum/Triticum_aestivum.IWGSC.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Triticum_aestivum/Triticum_aestivum.IWGSC.63.gtf.gz"
        }
        Solanum_lycopersicum {
            fasta = "${params.fasta_base_path}/Solanum_lycopersicum/Solanum_lycopersicum_gca000188115v5cm.SL4.0.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Solanum_lycopersicum/Solanum_lycopersicum_gca000188115v5cm.SL4.0.63.gtf.gz"
        }
        Daucus_carota {
            fasta = "${params.fasta_base_path}/Daucus_carota/Daucus_carota.ASM162521v1.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Daucus_carota/Daucus_carota.ASM162521v1.63.gtf.gz"
        }
        Helianthus_annuus {
            fasta = "${params.fasta_base_path}/Helianthus_annuus/Helianthus_annuus.HanXRQr2.0-SUNRISE.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Helianthus_annuus/Helianthus_annuus.HanXRQr2.0-SUNRISE.63.gtf.gz"
        }
        Alopecurus_myosuroides {
            fasta = "${params.fasta_base_path}/Alopecurus_myosuroides/Alopecurus_myosuroides_v1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Amaranthus_palmeri_hap1 {
            fasta = "${params.fasta_base_path}/Amaranthus_palmeri/Amaranthus_palmeri_hap1_v01.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Amaranthus_palmeri_hap2 {
            fasta = "${params.fasta_base_path}/Amaranthus_palmeri/Amaranthus_palmeri_hap2_v01.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Artemisia_annua {
            fasta = "${params.fasta_base_path}/Artemisia_annua/Artemisia_annua_v1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Cryptomeria_japonica {
            fasta = "${params.fasta_base_path}/Cryptomeria_japonica/Cryptomeria_japonica_1.0.fa.gz"
            gtf   = "${params.fasta_base_path}/Cryptomeria_japonica/GCF_030272615.1_Sugi_1.0_genomic.gtf.gz"
        }
        Nicotiana_benthamiana {
            fasta = "${params.fasta_base_path}/Nicotiana_benthamiana/Nicotiana_benthamiana_v1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Tragopogon_porrifolius_hap1 {
            fasta = "${params.fasta_base_path}/Tragopogon_porrifolius/Tragopogon_porrifolius_hap1.1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Tragopogon_porrifolius_hap2 {
            fasta = "${params.fasta_base_path}/Tragopogon_porrifolius/Tragopogon_porrifolius_hap2.1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Beta_vulgaris {
            fasta = "${params.fasta_base_path}/Beta_vulgaris/Beta_vulgaris.RefBeet-1.2.2.dna.fa.gz"
            gtf   = "${params.fasta_base_path}/Beta_vulgaris/Beta_vulgaris.RefBeet-1.2.2.63.gtf.gz"
        }
        Lycium_ruthenicum {
            fasta = "${params.fasta_base_path}/Lycium_ruthenicum/Lycium_ruthenicum_ASM4143038v1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
        Cynodon_dactylon {
            fasta = "${params.fasta_base_path}/Cynodon_dactylon/Cynodon_dactylon_ASM4686236v1.fa.gz"
            gtf   = null // 服务器无 GTF
        }
    }

    // ============================================================================
    // UMI Handling
    // ============================================================================
    with_umi = false
    skip_umi_extract = true
    save_umi_intermeds = false

    // ============================================================================
    // Linting
    // ============================================================================
    extra_fqlint_args = '--disable-validator P001 --disable-validator S007'

    // ============================================================================
    // Trimming
    // ============================================================================
    min_trimmed_reads = 10
    extra_trimgalore_args = '--length 25'
    save_trimmed = true
    skip_trimgalore = false

    // ============================================================================
    // BBSplit genome filtering
    // ============================================================================
    save_bbsplit_reads = false
    skip_bbsplit = true

    // ============================================================================
    // Ribosomal RNA removal
    // ============================================================================
    remove_ribo_rna = true
    save_non_ribo_reads = true
    ribo_database_manifest = "${params.riboseq_rnadb_dir}/rrna-db-full_local.txt"

    // ============================================================================
    // Alignment
    // ============================================================================
    aligner = 'star'
    pseudo_aligner = 'salmon'
    skip_pseudo_alignment = false
    save_merged_fastq = true
    save_unaligned = true
    save_align_intermeds = false
    skip_markduplicates = false
    skip_alignment = false

    // ============================================================================
    // QC
    // ============================================================================
    skip_qc = false
    skip_fastqc = false
    skip_multiqc = false
    skip_biotype_qc = false
    skip_dupradar = false
    skip_qualimap = false
    skip_rseqc = false

    // ============================================================================
    // Riboseq module-specific options
    // ============================================================================
    skip_ribotish = false
    skip_ribotricer = false
    skip_ribowaltz = false
    skip_ribocode = false
    skip_anota2seq = false

    // ============================================================================
    // Differential Expression Analysis
    // ============================================================================
    skip_deseq2_qc = false

    // ============================================================================
    // Genome Browser Files
    // ============================================================================
    skip_bigwig = false
    skip_stringtie = false

    // ============================================================================
    // MultiQC Report
    // ============================================================================
    multiqc_title = 'Oryza sativa SRP189094 Riboseq vs polyA RNA Analysis - Complete Pipeline'
}

// =========================================================================
// Global executor — server has 128 CPUs / 503 GB memory.
// Keep 32 cores and ~100 GB free for system/other users.
// =========================================================================
executor {
    name       = 'local'
    cpus       = 96
    memory     = '400 GB'
    queueSize  = 20
}

// ============================================================================
// Process Configuration
// ============================================================================
process {
    executor = 'local'

    // Error handling strategy
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors = '-1'

    // Global resource limits
    resourceLimits = [
        cpus: 100,
        memory: '400.GB',
        time: '48.h'
    ]

    // ========================================================================
    // Resource labels for different process types
    // ========================================================================
    withLabel: process_single {
        cpus = 1
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    withLabel: process_low {
        cpus = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    withLabel: process_medium {
        cpus = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
    }

    withLabel: process_high {
        cpus = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time = { 16.h * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }

    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    // ========================================================================
    // Process-specific configurations
    // ========================================================================
    // RiboCode metaplot generation
    withName: 'RIBOCODE_METAPLOTS' {
        ext.args = '-f0_percent 0 -pv1 1 -pv2 1'
    }

    // STAR alignment - more resources for rice genome
    withName: 'STAR_ALIGN' {
        cpus = { 16 * task.attempt }
        memory = { 40.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    // Salmon quantification
    withName: 'SALMON_QUANT' {
        ext.args = '--gcBias --seqBias'
        cpus = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
    }

    // SortMeRNA - rRNA removal
    withName: 'SORTMERNA' {
        ext.args = '--best 1 --num_alignments 1 -v'
        cpus = { 8 * task.attempt }
        memory = { 40.GB * task.attempt }
    }

    // DESeq2 differential expression
    withName: 'DESEQ2_QC' {
        memory = { 64.GB * task.attempt }
    }

    // Anota2seq: Disable built-in normalization to accept length-scaled continuous counts from Salmon
    withName: '.*ANOTA2SEQRUN.*' {
        ext.args = '--normalize FALSE'
    }
}

// Container engine — Docker only on this server
singularity {
    enabled = false
}

docker {
    enabled = true
}

conda {
    enabled = false
}

// Reports overwrite to avoid warnings on resume
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/trace.txt"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/timeline.html"
}
